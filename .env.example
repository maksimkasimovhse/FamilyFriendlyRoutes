# Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# GigaChat website extractor. Install the Ministry of Digital Development CA
# certificate and point GIGACHAT_CA_BUNDLE to it; do not disable TLS checks.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_MODEL=GigaChat-3-Pro
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_CA_BUNDLE=

# Скопируйте в .env (файл .env не попадает в Git) и задайте свой пароль.
POSTGRES_PASSWORD=change-me
# Порт на хосте. Если 5432 занят локальным PostgreSQL, используйте другой, например 5433.
POSTGRES_PORT=5432
DATABASE_URL=postgres://familyroutes:change-me@127.0.0.1:5432/familyroutes?sslmode=disable
# Compose uses postgres:5432 internally, independent of POSTGRES_PORT.
# Optional override for an external database; URL-encode special characters in credentials.
# DOCKER_DATABASE_URL=postgres://familyroutes:change-me@postgres:5432/familyroutes?sslmode=disable

# Optional phone HTTPS (configured by scripts/start-phone-https.ps1)
CADDY_HOST=localhost
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTPS_PORT=8443
CADDY_CERT_PORT=8088

# Optional internal ML token; Compose sends it from backend to Python services.
ML_API_TOKEN=
ML_REQUIRE_LEGACY_AUTH=false
# Only bounded, explicitly disclosed rules are used when GigaChat is unavailable.
ASSISTANT_RULES_FALLBACK=true

# Public server HTTPS: set PUBLIC_HOST to your domain or public-IP.sslip.io.
# Then use compose.yaml + compose.server.yaml (see docs/server_https.md).
# PUBLIC_HOST=203-0-113-10.sslip.io

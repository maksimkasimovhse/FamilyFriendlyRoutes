[Unit]
Description=Deploy FamilyFriendlyRoutes from origin/main
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=votter
Group=votter
SupplementaryGroups=docker
Environment=FAMILY_ROUTES_REPO=/home/votter/FamilyFriendlyRoutes
Environment=FAMILY_ROUTES_BRANCH=main
ExecStart=/usr/local/bin/family-routes-deploy-main

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/votter/FamilyFriendlyRoutes /home/votter/.local/state/family-routes

[Install]
WantedBy=multi-user.target
